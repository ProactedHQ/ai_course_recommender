# Backend environment variables — names only, no values.
# Production (cPanel): set these in "Setup Python App" > Environment variables.
#   settings.py reads the process environment only; it does not read this file or .env.
# Local development: copy to backend/.env (git-ignored); manage.py loads it.

# --- PayHero payments (apps/subscriptions) ---
PAYHERO_CHANNEL_ID=
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
# Must be https://<api-domain>/api/subscriptions/confirmation/
PAYHERO_CALLBACK_URL=
# Long random string; authenticates PayHero callbacks. Empty = all callbacks rejected.
PAYHERO_CALLBACK_SECRET=

# --- Django core (required) ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=
DATABASE_URL=
DB_CONN_MAX_AGE=
SECURE_HSTS_SECONDS=
ALLOW_LOCALHOST_CORS=False

# --- Supabase auth ---
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=
# Only used by backend/scripts/manage_roles.py
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (recommendations) ---
OPENAI_API_KEY=

# --- Redis cache / rate limiting (optional) ---
REDIS_URL=
