# Backend environment template - NAMES ONLY. Never put real values in this file or in git.
#
# Developers: `cp .env.example .env` gives a working local setup as-is:
#   SQLite + mock payments + no Redis. No credentials are needed or allowed.
# manage.py loads backend/.env. Staging/production values are set by the project owner on
# their servers and never go in this file. See docs/PAYMENTS.md.

# --- Environment (required for every manage.py command / script) -----------
# development | test | staging | production
APP_ENV=development
DEBUG=True

# --- Database ---------------------------------------------------------------
# Empty = SQLite file backend/db.sqlite3. APP_ENV=development refuses any database that is
# not on this machine (localhost/127.0.0.1/docker "db"/"postgres").
DATABASE_URL=
# require | prefer (local default) | disable
DB_SSLMODE=

# --- Payments ---------------------------------------------------------------
# development is always mock; PayHero credentials are discarded outside staging/production.
PAYMENT_PROVIDER=mock

# --- Optional local services --------------------------------------------------
# Local Redis only (redis://127.0.0.1:6379/1); a remote REDIS_URL is ignored in development.
REDIS_URL=
# Recommendations need an OpenAI key; without one, requests fail cleanly (prompt refunded).
# Use your own key, never the production one.
OPENAI_API_KEY=

# --- Auth (Supabase) ----------------------------------------------------------
# The "PROACTED KeDira Development" project URL (https://<dev-ref>.supabase.co). The production
# project is refused in development. See docs/PAYMENTS.md, "Development login".
SUPABASE_URL=
# Only if the development project still uses the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=

# --- Staging / production only (owner-controlled; ignored or refused in development) ---
SECRET_KEY=
ALLOWED_HOSTS=
DB_CONN_MAX_AGE=
SECURE_HSTS_SECONDS=
ALLOW_LOCALHOST_CORS=
PAYHERO_ALLOW_NON_PRODUCTION=
PAYHERO_CHANNEL_ID=
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CALLBACK_URL=
PAYHERO_CALLBACK_SECRET=
PAYHERO_VERIFY_WITH_STATUS_API=
PAYMENT_PENDING_TIMEOUT_MINUTES=
# Only used by backend/scripts/manage_roles.py (refuses the production project unless APP_ENV=production)
SUPABASE_SERVICE_ROLE_KEY=
