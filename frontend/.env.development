# Committed defaults for `npm run dev` (Vite "development" mode). NO secrets, NO production values.
#
# Local login uses the separate "PROACTED KeDira Development" Supabase project. Put its URL and
# public client key (anon / publishable key) in frontend/.env.development.local, which is
# git-ignored (*.local) and overrides this file. The production project is refused in development.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local Django backend
VITE_API_BASE_URL=http://localhost:8000
