# Frontend build variables - NAMES ONLY here. These end up in public JavaScript, so they must
# never hold secrets: no PayHero values, no service-role/secret keys, no database URLs.
#
# Local development: create frontend/.env.development.local (git-ignored) with the
# "PROACTED KeDira Development" Supabase project's URL and public client key.
# Production builds read frontend/.env.production (production project + production API).
VITE_SUPABASE_URL=
# Public client key: the project's "anon" key or "publishable" key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=
# Local backend: http://localhost:8000
VITE_API_BASE_URL=
